# Unnecessary Intelligence — environment template.
# Copy to .env and fill locally. .env is gitignored — NEVER commit secrets.

# HeyGen Developer API wallet key — funds TTS + avatar renders.
# (The funded MALB wallet was observed ~$0.45/video; this may be a shared or
#  separate UI wallet — confirm with owner before first paid call.)
HEYGEN_API_KEY=

# Optional: override browser exe for tools/render_html.py
# UI_BROWSER_EXE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Meta Model API key — OPTIONAL. Enables tools/meta_provider.py:
# video-understanding QC (Muse Spark/Ember), Muse Image, SAM 3.1.
# No video-GENERATION model exists on this API (see docs/META-AI-INVESTIGATION.md).
MODEL_API_KEY=

# Metricool brand id for UI social scheduling — create the brand first.
METRICOOL_BRAND_ID=

# Cloudflare — only needed when deploying tools/r2-serve for social delivery.
CF_ACCOUNT_ID=
